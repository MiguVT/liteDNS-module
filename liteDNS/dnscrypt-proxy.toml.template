# liteDNS dnscrypt-proxy.toml.template
# This file is copied to dnscrypt-proxy.toml at first boot.
# Certain lines are overwritten by service.sh based on config.sh.

##############################
# Core Settings
##############################

# Listen on local loopback
listen_addresses = ['127.0.0.1:53']

# Resolver servers to use (DoH only)
server_names = ['cloudflare']

# Enable DNS-over-HTTPS
doh_servers = true
dnscrypt_servers = false
odoh_servers = false

# IPv6 support
ipv6_servers = true

##############################
# Privacy / Filtering Options
##############################

require_dnssec   = true
require_nolog    = true
require_nofilter = true

# fallback plaintext DNS if DoH fails (for initial bootstrap or fallback)
fallback_resolvers = ['1.0.0.1:53']

##############################
# Performance and Logging
##############################

max_clients = 250
keepalive = 30
log_level = 2

# Optional: enable query/response logging
# log_file = 'dnscrypt-proxy.log'

# Cache responses to speed up
cache = true
cache_size = 4096

##############################
# Advanced / Security
##############################

tls_disable_session_tickets = true
block_ipv6 = false