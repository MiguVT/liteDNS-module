#!/system/bin/sh
# liteDNS configuration template
# Copy this to config.sh on first install.
#
# VERSION tag – bump when adding new options or making major changes
VERSION="003"

# ─────────────────────────────GLOBAL OPTIONS────────────────────────────
# Verbose logging (detailed service.log entries)
#   1 = enabled, 0 = silent
VERBOSE_LOG=1

# IPv6 DNS support (applies to system DNS and dnscrypt-proxy)
#   1 = enabled, 0 = IPv4 only
ENABLE_IPV6=1

# Wi-Fi custom DNS override
#   1 = apply module DNS to Wi-Fi (default)
#   0 = keep DHCP-provided DNS on Wi-Fi (recommended for people that use custom DNS on their router or AP)
WIFI_CUSTOM_DNS=1

# ──────────────────────────────DOH OPTIONS──────────────────────────────
# Enable DNS-over-HTTPS via dnscrypt-proxy
#   1 = enabled, 0 = disabled
ENABLE_DOH=1

# Which DoH server(s) to use:
#   • Use provider names from the official dnscrypt-proxy public-resolvers list
#   • Multiple can be separated by commas (e.g., cloudflare,quad9,google)
DOH_SERVERS_NAME='cloudflare'

# Failsafe IPv4 fallback if DoH fails to start
#   1 = revert to DNS1/DNS2, 0 = stay on localhost
FAILSAFE_FALLBACK=1

# ──────────────────────────────DNS OPTIONS──────────────────────────────
# Upstream plaintext DNS servers (Cloudflare defaults)
DNS1=1.1.1.1
DNS2=1.0.0.1

# Upstream IPv6 DNS servers (Cloudflare defaults)
DNS6_1=2606:4700:4700::1111
DNS6_2=2606:4700:4700::1001

# ───────────────────────────────────────────────────────────────────────
# To apply changes: edit any value above and reboot your device.
# Advanced users can also edit dnscrypt-proxy.toml after first boot.
# (if you don’t know where to find it, don’t edit it)
